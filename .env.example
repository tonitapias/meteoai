# URL del teu Proxy per a l'API de Gemini (OBLIGATORI)
VITE_PROXY_URL=https://la-teva-url-del-proxy.com/api/chat

# Token de Mapbox per al mapa de radar (OBLIGATORI perquè el radar funcioni)
VITE_MAPBOX_TOKEN=

# Temps d'espera per a les peticions a l'API, en ms (OPCIONAL, per defecte 10000)
VITE_API_TIMEOUT=10000

# Endpoints d'Open-Meteo (OPCIONALS, per defecte apunten a l'API pública d'Open-Meteo)
VITE_API_WEATHER_BASE=
VITE_API_AQI_BASE=

# Endpoint de geocodificació inversa (OPCIONAL, per defecte BigDataCloud)
VITE_API_GEOCODING=
